# Copy to .env in the repository root. Keep keys local.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# Retrieval tries Embedding + Chroma, then falls back to local TF-IDF.
# The selected API provider must support the embedding model to use this path.
EMBEDDING_MODEL=text-embedding-3-small
APP_ENV=development
DEBUG=true
